Options -MultiViews

RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.e4engineers\.in$ [NC]
RewriteRule ^ https://e4engineers.in%{REQUEST_URI} [R=301,L]

RewriteRule ^blog/?$ /articles/ [R=301,L,NC]
RewriteRule ^(choice-of-size-and-number-of-generator-units|factors-affecting-cost-of-power-generation-power-system-economics|load-curve-load-duration-curve-integrated-curve|economics-of-power-generation|technologies-of-smart-grid-system|architecture-of-smart-grid|what-is-a-smart-grid-technologies-advantages-applications)/?$ /articles/$1/ [R=301,L,NC]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} =~ m#^/(admin|account|cart|checkout|login|register|forgot-password|reset-password|order-success|support|search)(/|$)#"
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
