{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-assets.mjs && vite build && node scripts/generate-seo-pages.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:seo": "node --test tests/seo-build.test.mjs",
    "test:auth": "node --test tests/auth-navigation.test.mjs tests/auth-service.test.mjs"
    ,"test:contributors": "node --test tests/contributors-service.test.mjs",
    "test:articles": "node --test tests/articles-service.test.mjs",
    "test:resources": "node --test tests/resources-service.test.mjs",
    "test:digital-access": "node --test tests/digital-access-service.test.mjs",
    "test:books": "node --test tests/books-service.test.mjs",
    "test": "node --test tests"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
